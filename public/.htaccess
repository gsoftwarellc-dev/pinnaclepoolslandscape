# Static export served by Apache. Next.js cannot emit redirects or rewrites here,
# so the rules that lived in next.config.ts are expressed directly.

Options -Indexes

# The old flat quote form was replaced by the multi-step estimate tool.
Redirect 301 /quote /estimate/

# The Resend key lives in api/config.php; never serve it as text.
<Files "config.php">
    Require all denied
</Files>
<Files "config.example.php">
    Require all denied
</Files>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Hashed build assets are immutable; photos change rarely.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>

ErrorDocument 404 /404.html
